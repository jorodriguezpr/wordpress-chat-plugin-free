{
  "name": "wordpress-chat-plugin/ai-powered-chat",
  "description": "AI-powered chat plugin for WordPress with multi-provider support (OpenAI, Claude, Gemini, GitHub Copilot)",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Jose Rodriguez Arroyo",
      "email": "jrpcone@gmail.com",
      "homepage": "https://www.microrepair.net"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "phpcs": "^3.7",
    "wp-coding-standards/wpcs": "^2.4"
  },
  "autoload": {
    "classmap": [
      "includes/",
      "admin/",
      "public/"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=WordPress --colors ./includes/ ./admin/ ./public/",
    "fix": "phpcbf --standard=WordPress --colors ./includes/ ./admin/ ./public/"
  }
}
